# Copy to .env and replace with your OWN local credentials.
DATABASE_URL=postgresql://hungr:change-me@localhost:5432/hungr
# Optional. Without an API key HUNGR uses a transparent budget-safe planner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible providers may set this URL.
OPENAI_BASE_URL=https://api.openai.com/v1
